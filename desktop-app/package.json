{
  "name": "fitlab",
  "version": "1.0.0",
  "description": "FitLAB - Akademik Spor Bilimi ve AI İstasyonu (Masaüstü)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "rm -rf dist && electron-builder --dir && dot_clean \"dist/mac-arm64/FitLAB.app\" && xattr -cr \"dist/mac-arm64/FitLAB.app\" && codesign --force --deep --sign - --entitlements build/entitlements.mac.plist \"dist/mac-arm64/FitLAB.app\"",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "keywords": [
    "fitlab",
    "sports-science",
    "electron",
    "ai-coach",
    "hypertrophy"
  ],
  "author": "FitLAB",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "chart.js": "^4.4.7",
    "firebase": "^10.14.1"
  },
  "build": {
    "appId": "io.kantarci.fitlab",
    "productName": "FitLAB",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.sports",
      "identity": null,
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dir",
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
